{
  "name": "@mdgascar/date",
  "version": "0.7.0",
  "description": "Malagasy dates: 'Alatsinainy 23 Novambra 2026', month and weekday names, from CLDR.",
  "license": "MIT",
  "author": "Mdgascar contributors",
  "homepage": "https://github.com/mdgascar/mdg-utils-js/tree/main/packages/date#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgascar/mdg-utils-js.git",
    "directory": "packages/date"
  },
  "bugs": "https://github.com/mdgascar/mdg-utils-js/issues",
  "keywords": [
    "madagascar",
    "malagasy",
    "date",
    "calendar",
    "months",
    "weekdays",
    "cldr"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "api": "api-extractor run --local"
  }
}
