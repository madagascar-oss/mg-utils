{
  "name": "@madagascar-oss/phone",
  "version": "0.5.0",
  "description": "Parse, validate and format Madagascar (+261) mobile phone numbers.",
  "license": "MIT",
  "author": "Madagascar OSS contributors",
  "homepage": "https://github.com/madagascar-oss/mg-utils-js/tree/main/packages/phone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madagascar-oss/mg-utils-js.git",
    "directory": "packages/phone"
  },
  "bugs": "https://github.com/madagascar-oss/mg-utils-js/issues",
  "keywords": [
    "madagascar",
    "malagasy",
    "phone",
    "phone-number",
    "validation",
    "e164"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "api": "api-extractor run --local"
  }
}
