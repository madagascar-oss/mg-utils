{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*/index.ts"],
      "project": ["tools/**/*.ts", "demo/**/*.ts"]
    },
    "packages/*": {
      "entry": ["test/**/*.{test,bench}.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "conformance": {
      "entry": ["*.test.ts"],
      "project": ["**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["packages/*/src/generated/**"]
}
