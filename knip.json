{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*/index.ts"],
      "project": ["tools/**/*.ts"]
    },
    "js/packages/*": {
      "entry": ["test/**/*.{test,bench}.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "js/test-runner": {
      "entry": ["*.test.ts"],
      "project": ["**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["js/packages/*/src/generated/**", "php/**"]
}
