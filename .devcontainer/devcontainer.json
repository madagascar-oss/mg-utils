{
  "name": "mg-utils-js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/guiyomh/features/just:0": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "pipx install yamllint && just setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "nefrob.vscode-just-syntax",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "yaml.schemas": {
          "spec/schemas/tests.schema.json": "spec/modules/*/tests.yaml",
          "spec/modules/phone/schema.json": "spec/modules/phone/data.yaml",
          "spec/modules/words/schema.json": "spec/modules/words/data.yaml"
        }
      }
    }
  }
}
