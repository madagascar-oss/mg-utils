{
  "name": "mg-utils-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "hooks": "lefthook install",
    "codegen": "node tools/codegen/index.ts",
    "new-module": "node tools/new-module/index.ts",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . && pnpm typecheck && knip",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "api": "pnpm -r --filter \"./packages/*\" api",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "spec-claim": "node tools/spec-claim/index.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.3",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "^4.11.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
