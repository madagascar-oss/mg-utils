{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@madagascar-oss/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "conformance/**/*.ts",
    "tools/**/*.ts",
    "demo/**/*.ts",
    "*.ts",
    "*.js"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "spec/**"]
}
