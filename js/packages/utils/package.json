{
  "name": "@madagascar-oss/utils",
  "version": "0.0.0",
  "description": "All mg-utils modules in one package: Malagasy number words and phone numbers.",
  "license": "MIT",
  "author": "Madagascar OSS contributors",
  "homepage": "https://github.com/madagascar-oss/mg-utils/tree/main/js/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madagascar-oss/mg-utils.git",
    "directory": "js/packages/utils"
  },
  "bugs": "https://github.com/madagascar-oss/mg-utils/issues",
  "keywords": [
    "madagascar",
    "malagasy",
    "utils"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "api": "api-extractor run --local"
  },
  "dependencies": {
    "@madagascar-oss/phone": "workspace:^",
    "@madagascar-oss/words": "workspace:^"
  }
}
